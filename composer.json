{
    "name": "artadns/web",
    "description": "ArtaDNS Website - PHP 8.4",
    "type": "project",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "squizlabs/php_codesniffer": "^3.8",
        "friendsofphp/php-cs-fixer": "^3.58"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.4.27"
        }
    },
    "autoload": {
        "psr-4": {
            "ArtaDNS\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": "phpcs --standard=PSR12 src/ includes/ config/",
        "lint:fix": "phpcbf --standard=PSR12 src/ includes/ config/",
        "analyze": "phpstan analyse src/ includes/ config/ --level=5",
        "test": "phpunit",
        "serve": "php -S localhost:8000 -t ."
    }
}